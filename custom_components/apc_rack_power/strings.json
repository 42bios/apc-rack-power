{
  "config": {
    "flow_title": "{host}",
    "step": {
      "user": {
        "title": "APC network management card",
        "description": "Connect an APC UPS or Rack PDU through its network management card (NMC).\n\nSNMPv3 is recommended: it authenticates every request and encrypts the traffic. SNMPv1 and SNMPv2c send the community string in plain text.",
        "data": {
          "host": "Host",
          "name": "Name",
          "port": "SNMP port",
          "snmp_version": "SNMP version"
        },
        "data_description": {
          "host": "IP address or host name of the network management card.",
          "name": "Name of the device in Home Assistant.",
          "snmp_version": "Must be enabled on the card (Configuration → Network → SNMPv1 / SNMPv3)."
        }
      },
      "reconfigure": {
        "title": "Reconfigure connection",
        "description": "Change the address, port or SNMP version. The credentials follow in the next step.",
        "data": {
          "host": "Host",
          "port": "SNMP port",
          "snmp_version": "SNMP version"
        },
        "data_description": {
          "snmp_version": "SNMPv3 is recommended; v1/v2c transmit the community in plain text."
        }
      },
      "community": {
        "title": "Community strings ({version})",
        "description": "Enter the community strings configured on the network card.\n\n**Security notice:** {version} sends the community string and all values in plain text, and anyone who knows the write community can switch outlets. If your card supports it, use **SNMPv3** with authentication and encryption (for example SHA-256 and AES) instead. You can switch later via *Reconfigure*.",
        "data": {
          "community": "Read community",
          "write_community": "Write community"
        },
        "data_description": {
          "community": "Community with read access (the card's default is \"public\").",
          "write_community": "Needed to switch outlets, run self tests and change settings. Leave empty to use the read community."
        }
      },
      "v3": {
        "title": "SNMPv3 credentials",
        "description": "Enter an SNMPv3 user of the network card. Use authentication and privacy (authPriv) for full protection.",
        "data": {
          "v3_username": "User name",
          "v3_auth_protocol": "Authentication protocol",
          "v3_auth_passphrase": "Authentication passphrase",
          "v3_priv_protocol": "Privacy protocol",
          "v3_priv_passphrase": "Privacy passphrase"
        },
        "data_description": {
          "v3_auth_protocol": "Must match the user's setting on the card. SHA-256 or stronger is recommended where supported.",
          "v3_priv_protocol": "Must match the user's setting on the card. For AES-192/256 there are two key formats; if one fails, try the other.",
          "v3_auth_passphrase": "At least 8 characters.",
          "v3_priv_passphrase": "At least 8 characters."
        }
      }
    },
    "error": {
      "cannot_connect": "No SNMP response. Check address, port, SNMP version and the card's access control list.",
      "invalid_auth": "The card rejected the SNMPv3 credentials.",
      "username_required": "A user name is required.",
      "passphrase_too_short": "The passphrase must have at least 8 characters.",
      "priv_requires_auth": "Encryption requires an authentication protocol."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "reconfigure_successful": "The connection was updated.",
      "reauth_successful": "The credentials were updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "Address, SNMP version and credentials are changed via **Reconfigure** in the menu of this entry.",
        "sections": {
          "polling": {
            "name": "Polling",
            "description": "How often and how patiently the network card is queried.",
            "data": {
              "scan_interval": "Scan interval",
              "timeout": "Timeout",
              "retries": "Retries"
            },
            "data_description": {
              "scan_interval": "Seconds between two updates. 30 s is a good default; older cards (NMC2) answer slower.",
              "timeout": "Seconds to wait for an answer.",
              "retries": "Repeats before a request counts as failed."
            }
          },
          "traps": {
            "name": "SNMP traps",
            "description": "Instant updates when the card reports an event (mains failure, alarms, outlet changes).",
            "data": {
              "trap_enabled": "Receive SNMP traps",
              "trap_port": "Port (UDP)",
              "trap_community": "Trap community"
            },
            "data_description": {
              "trap_enabled": "Add Home Assistant as trap receiver on the card: Configuration → Notification → SNMP Traps → Trap Receivers.",
              "trap_port": "162 is the standard. Use a port above 1024 if 162 is not available and set the same port on the card.",
              "trap_community": "Community the card sends with its traps. Empty accepts any trap from this device."
            }
          },
          "advanced": {
            "name": "Advanced",
            "description": "Additional values that the integration does not read on its own.",
            "data": {
              "custom_oids": "Custom OIDs"
            },
            "data_description": {
              "custom_oids": "One per line as name=OID, e.g. battery_cartridge=.1.3.6.1.4.1.318.1.1.1.2.2.19.0. Each line becomes a diagnostic sensor."
            }
          }
        }
      }
    }
  },

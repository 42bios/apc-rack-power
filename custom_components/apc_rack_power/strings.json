  "exceptions": {
    "no_data": {
      "message": "The device answered without any APC values. Check the SNMP access settings."
    },
    "auth_failed": {
      "message": "The device rejected the SNMPv3 credentials: {error}"
    },
    "update_failed": {
      "message": "Cannot read the device: {error}"
    },
    "write_failed": {
      "message": "The device did not accept the command: {error}"
    },
    "reboot_not_supported": {
      "message": "This outlet does not support a reboot command."
    },
    "unknown_entry": {
      "message": "No loaded APC Rack Power entry with id {entry_id}."
    },
    "unknown_control": {
      "message": "No outlet or outlet group with uid {control_uid}."
    }
  },
  "issues": {
    "battery_replace": {
      "title": "Replace the battery of {name}",
      "description": "The UPS {name} reports that its battery needs replacing. After the replacement, update the battery installation date on the network management card so the warning clears."
    },
    "write_failed": {
      "title": "{name} rejects commands",
      "description": "A command to {name} failed. Check that the write community (SNMPv1/v2c) or the SNMPv3 user has write access on the network management card, and that Home Assistant is allowed in the card's access control list. Change the credentials via Reconfigure."
    },
    "trap_port": {
      "title": "Cannot receive SNMP traps for {name}",
      "description": "Home Assistant cannot listen on UDP port {port} ({error}). Choose a port above 1024 in the options and configure the same port as trap receiver on the network card."
    }
  },

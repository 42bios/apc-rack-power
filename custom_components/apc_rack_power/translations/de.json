{
  "config": {
    "flow_title": "{host}",
    "step": {
      "user": {
        "title": "APC-Netzwerkkarte",
        "description": "Verbinde eine APC-USV oder Rack-PDU über ihre Netzwerkkarte (NMC).\n\nEmpfohlen ist SNMPv3: Es prüft jede Anfrage und verschlüsselt die Verbindung. SNMPv1 und SNMPv2c übertragen die Community im Klartext.",
        "data": {
          "host": "Host",
          "name": "Name",
          "port": "SNMP-Port",
          "snmp_version": "SNMP-Version"
        },
        "data_description": {
          "host": "IP-Adresse oder Hostname der Netzwerkkarte.",
          "name": "Name des Geräts in Home Assistant.",
          "snmp_version": "Muss auf der Karte aktiviert sein (Configuration → Network → SNMPv1 / SNMPv3)."
        }
      },
      "reconfigure": {
        "title": "Verbindung ändern",
        "description": "Adresse, Port oder SNMP-Version ändern. Die Zugangsdaten folgen im nächsten Schritt.",
        "data": {
          "host": "Host",
          "port": "SNMP-Port",
          "snmp_version": "SNMP-Version"
        },
        "data_description": {
          "snmp_version": "SNMPv3 wird empfohlen; v1/v2c übertragen die Community im Klartext."
        }
      },
      "community": {
        "title": "Communities ({version})",
        "description": "Gib die auf der Netzwerkkarte eingestellten Communities ein.\n\n**Sicherheitshinweis:** {version} überträgt die Community und alle Werte im Klartext, und wer die Schreib-Community kennt, kann Steckdosen schalten. Wenn deine Karte es unterstützt, nutze besser **SNMPv3** mit Anmeldung und Verschlüsselung (bei APC-Karten: SHA und AES). Umstellen kannst du später über *Neu konfigurieren*.",
        "data": {
          "community": "Lese-Community",
          "write_community": "Schreib-Community"
        },
        "data_description": {
          "community": "Community mit Lesezugriff (Werkseinstellung der Karte: „public“).",
          "write_community": "Nötig zum Schalten von Steckdosen, für Selbsttests und Einstellungen. Leer lassen, um die Lese-Community zu verwenden."
        }
      },
      "v3": {
        "title": "SNMPv3-Zugangsdaten",
        "description": "Gib einen SNMPv3-Benutzer der Netzwerkkarte ein. Vollen Schutz bieten Anmeldung und Verschlüsselung (authPriv).\n\nAuf der Karte: Benutzer anlegen (SNMPv3 → User Profiles), mit der Adresse von Home Assistant oder 0.0.0.0 freigeben (SNMPv3 → Access Control) und unter SNMPv3 → Access **Enable** anhaken.",
        "data": {
          "v3_username": "Benutzername",
          "v3_auth_protocol": "Anmeldeverfahren",
          "v3_auth_passphrase": "Anmelde-Passphrase",
          "v3_priv_protocol": "Verschlüsselung",
          "v3_priv_passphrase": "Verschlüsselungs-Passphrase"
        },
        "data_description": {
          "v3_auth_protocol": "Muss zum Benutzer auf der Karte passen. APC-Karten bieten meist SHA (SHA-1) und MD5 – wähle SHA. SHA-2-Varianten nur, wenn deine Karte sie anbietet.",
          "v3_priv_protocol": "Muss zum Benutzer auf der Karte passen. Wähle AES (AES-128), DES besser nicht. Für AES-192/256 gibt es zwei Schlüsselformate; klappt eines nicht, probiere das andere.",
          "v3_auth_passphrase": "Mindestens 8 Zeichen.",
          "v3_priv_passphrase": "Mindestens 8 Zeichen."
        }
      }
    },
    "error": {
      "cannot_connect": "Keine SNMP-Antwort. Prüfe Adresse, Port, SNMP-Version und die Zugriffsfreigabe der Karte. Bei SNMPv3 schweigen APC-Karten auch, wenn Benutzername, Passphrase oder Verfahren nicht passen oder SNMPv3 auf der Karte nicht aktiviert ist.",
      "invalid_auth": "Die Karte hat die SNMPv3-Zugangsdaten abgelehnt.",
      "username_required": "Ein Benutzername ist erforderlich.",
      "passphrase_too_short": "Die Passphrase braucht mindestens 8 Zeichen.",
      "priv_requires_auth": "Verschlüsselung setzt ein Anmeldeverfahren voraus."
    },
    "abort": {
      "already_configured": "Dieses Gerät ist bereits eingerichtet.",
      "reconfigure_successful": "Die Verbindung wurde aktualisiert.",
      "reauth_successful": "Die Zugangsdaten wurden aktualisiert.",
      "wrong_device": "Diese Adresse gehört zu einer anderen Netzwerkkarte als der dieses Eintrags."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Optionen",
        "description": "Adresse, SNMP-Version und Zugangsdaten änderst du über **Neu konfigurieren** im Menü dieses Eintrags.",
        "sections": {
          "polling": {
            "name": "Abfrage",
            "description": "Wie oft und wie geduldig die Netzwerkkarte abgefragt wird.",
            "data": {
              "scan_interval": "Abfrageintervall",
              "timeout": "Zeitlimit",
              "retries": "Wiederholungen"
            },
            "data_description": {
              "scan_interval": "Sekunden zwischen zwei Abfragen. 30 s sind ein guter Wert; ältere Karten (NMC2) antworten langsamer.",
              "timeout": "Sekunden Wartezeit auf eine Antwort.",
              "retries": "Wiederholungen, bevor eine Anfrage als fehlgeschlagen gilt."
            }
          },
          "traps": {
            "name": "SNMP-Traps",
            "description": "Sofortige Aktualisierung, wenn die Karte ein Ereignis meldet (Netzausfall, Alarme, Steckdosen).",
            "data": {
              "trap_enabled": "SNMP-Traps empfangen",
              "trap_port": "Port (UDP)",
              "trap_community": "Trap-Community"
            },
            "data_description": {
              "trap_enabled": "Home Assistant auf der Karte als Trap-Empfänger eintragen (Configuration → Notification → SNMP Traps → Trap Receivers). SNMPv3-Traps funktionieren mit dem SNMPv3-Benutzer dieses Eintrags. Eine Firewall auf dem HA-Host muss UDP von der Karte zulassen.",
              "trap_port": "162 ist der Standard. Ist 162 nicht verfügbar, einen Port über 1024 wählen und auf der Karte denselben eintragen.",
              "trap_community": "Community, die die Karte bei SNMPv1/v2c-Traps mitsendet. SNMPv3-Traps werden mit dem Benutzer dieses Eintrags geprüft und entschlüsselt. Leer: nur SNMPv3-Traps."
            }
          },
          "advanced": {
            "name": "Erweitert",
            "description": "Zusätzliche Werte, die die Integration nicht selbst ausliest.",
            "data": {
              "custom_oids": "Eigene OIDs"
            },
            "data_description": {
              "custom_oids": "Eine pro Zeile als name=OID, z. B. battery_cartridge=.1.3.6.1.4.1.318.1.1.1.2.2.19.0. Jede Zeile wird ein Diagnose-Sensor."
            }
          }
        }
      }
    }
